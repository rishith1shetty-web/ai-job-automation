DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linkedin_auto_apply
OPENAI_API_KEY=
OPENAI_MATCH_MODEL=gpt-4o-mini
LINKEDIN_STORAGE_STATE=storage/linkedin_state.json
LINKEDIN_HEADLESS=false
LINKEDIN_SLOW_MO_MS=50
APP_UPLOAD_DIR=storage/uploads
# Apply All ceiling per batch. Matches the Find Matches cap (100) so Apply All can process
# every eligible job in one click. Lower it to throttle bulk runs.
MAX_APPLICATIONS_PER_RUN=100
AUTO_APPLY_DRY_RUN=true
API_BASE_URL=http://localhost:8000

# --- Web interface -------------------------------------------------------------------------
# Leave unset for normal use.
#
# SERVE_FRONTEND   Unset = automatic: a packaged build serves frontend/dist from FastAPI
#                  (no Node.js, no Vite); a source checkout leaves the UI to the Vite dev
#                  server on :5173. "true" forces FastAPI to serve the built assets (open
#                  http://127.0.0.1:8000); "false" forces the development behaviour.
#                  start_app.ps1 sets this for you: -Packaged => true, otherwise false.
# FRONTEND_DIST_DIR  Location of the built assets. Defaults to <install>/frontend/dist. This
#                  is a bundled read-only asset, so a relative value is resolved against the
#                  installation directory, not the writable data directory.
#
# Build the assets once with:  cd frontend; npm install; npm run build
#
# SERVE_FRONTEND=
# FRONTEND_DIST_DIR=

# --- Writable runtime locations (app/paths.py) ---------------------------------------------
# Leave these unset for normal use.
#
# Running from a source checkout, all writable data stays project-relative exactly as before
# (outputs/, work/, storage/). A packaged install instead keeps EVERYTHING under one
# machine-local folder:
#   %LOCALAPPDATA%\AIJobAutomation\  outputs, logs, work, screenshots, html_diagnostics,
#                                    cache, storage, uploads, browser_sessions, config
# Roaming application data (%APPDATA%) is deliberately never used: it can be synchronised
# between computers in a managed Windows environment, which would carry resumes, uploads,
# configuration and signed-in LinkedIn/Dice sessions onto another machine. Each Windows
# account on each computer therefore keeps entirely separate data.
#
# AI_JOB_AUTOMATION_DATA_DIR         Redirect EVERYTHING under one root (used by the tests).
# AI_JOB_AUTOMATION_MODE             Force "packaged" or "development" resolution.
# AI_JOB_AUTOMATION_LOCAL_DATA_DIR   Override the machine-local data root.
#
# Inspect the resolved layout at any time (prints directories only, never secrets):
#   .venv\Scripts\python.exe -m app.paths
#
# AI_JOB_AUTOMATION_DATA_DIR=
# Relative values for the path settings above (e.g. APP_UPLOAD_DIR=storage/uploads) are
# anchored to the resolved data root, never to the current working directory.
